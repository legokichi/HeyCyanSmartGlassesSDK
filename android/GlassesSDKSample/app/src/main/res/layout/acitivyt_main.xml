<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="MissingClass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/qc_dp_24">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qc_dp_80">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/btn_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_1" />

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_2" />

            <Button
                android:id="@+id/btn_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_3" />

            <Button
                android:id="@+id/btn_add_listener"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_11" />

        </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/btn_set_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_4" />

            <Button
                android:id="@+id/btn_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_5" />

            <Button
                android:id="@+id/btn_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_6" />

            <Button
                android:id="@+id/btn_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_7" />


        </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btn_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_8" />

        <Button
            android:id="@+id/btn_thumbnail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_9" />

        <Button
            android:id="@+id/btn_bt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_10" />

        <Button
            android:id="@+id/btn_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_12" />

        <Button
            android:id="@+id/btn_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_13" />

        <Button
            android:id="@+id/btn_media_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_14" />

        <Button
            android:id="@+id/btn_data_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_15" />

        <TextView
            android:id="@+id/text_periodical_capture_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/qc_dp_16"
            android:layout_marginTop="@dimen/qc_dp_24"
            android:layout_marginEnd="@dimen/qc_dp_16"
            android:text="@string/periodical_capture_title"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layout_periodical_capture_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/qc_dp_16"
            android:layout_marginTop="@dimen/qc_dp_8"
            android:layout_marginEnd="@dimen/qc_dp_16"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_periodical_capture_interval_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/periodical_capture_interval_label" />

                <EditText
                    android:id="@+id/input_periodical_capture_interval"
                    android:layout_width="@dimen/qc_dp_80"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="number"
                    android:maxLines="1"
                    android:text="60" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qc_dp_8"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_periodical_capture_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/periodical_capture_start" />

                <Button
                    android:id="@+id/btn_periodical_capture_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/qc_dp_8"
                    android:layout_weight="1"
                    android:text="@string/periodical_capture_stop" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</ScrollView>
