<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Glasses media transfer uses HTTP on dynamic Wi-Fi Direct IPs. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config> 
